# ---------------------------------------------------------------------------
# DirectorHUD — runtime configuration
# Copy to .env and fill in secrets. Never commit .env.
# ---------------------------------------------------------------------------

# Ingest provider: "mock" (seeded synthetic stream, no credentials needed) or
# "twitch" (live Twitch IRC via tmi.js). Defaults to "twitch" only when both
# Twitch credentials below are present, otherwise "mock".
DIRECTORHUD_PROVIDER=mock

# --- Twitch IRC (only required when provider=twitch) -----------------------
TWITCH_CHANNEL=powerworks
TWITCH_OAUTH=oauth:REPLACE_WITH_OAUTH_TOKEN   # https://twitchapps.com/tmi/ or console dev token
TWITCH_BOT_NAME=directorhud_bot

# --- Phase 2: headline API (optional; teaser fallback works without it) ---
# Create a key at https://platform.openai.com/api-keys — never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HUD overlay port (OBS Browser Source → http://localhost:<port>/)
DIRECTORHUD_HUD_PORT=8788

# --- Spike detector tuning (optional overrides, shown = defaults) ----------
DIRECTORHUD_WINDOW_MS=10000            # evaluation window per bucket
DIRECTORHUD_WARMUP_WINDOWS=6           # quiet windows before arming (~60s)
DIRECTORHUD_EWMA_ALPHA=0.3             # baseline adaptation rate
DIRECTORHUD_VELOCITY_K=3.0             # velocity trigger: MPS > baseline * K
DIRECTORHUD_EMOTE_DENSITY_MIN=2.5      # emote trigger: emotes/message >= this

# --- Phase 3: clip export (optional; unset DIRECTORHUD_RECORDING_PATH = off) ---
# Point this at OBS's own continuous local recording file (Settings → Output
# → Recording). DirectorHUD slices clips from it by timestamp offset — it
# never captures Twitch video itself. See docs/adr/002.
DIRECTORHUD_RECORDING_PATH=
# Epoch ms when that recording started — must share a clock with this
# machine. Defaults to "now" (process start) if unset; set explicitly for
# accurate offsets if OBS was already recording before you started DirectorHUD.
DIRECTORHUD_RECORDING_STARTED_AT=
DIRECTORHUD_CLIP_OUTPUT_DIR=./clips
DIRECTORHUD_CLIP_MANIFEST=./clips/clip-manifest.jsonl
DIRECTORHUD_CLIP_PREROLL_MS=15000
DIRECTORHUD_CLIP_POSTROLL_MS=10000
DIRECTORHUD_CLIP_SOURCE_WIDTH=1920
DIRECTORHUD_CLIP_SOURCE_HEIGHT=1080
